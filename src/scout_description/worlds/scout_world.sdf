<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="scout_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.45 0.45 0.47 1</ambient>
      <background>0.72 0.75 0.80 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- ==================== ground ==================== -->

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.56 0.58 1</ambient>
            <diffuse>0.62 0.63 0.65 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== outer walls (12 x 9 m arena) ==================== -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 4.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.15 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.15 1.5</size></box></geometry>
          <material><ambient>0.86 0.86 0.88 1</ambient><diffuse>0.92 0.92 0.94 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.15 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.15 1.5</size></box></geometry>
          <material><ambient>0.86 0.86 0.88 1</ambient><diffuse>0.92 0.92 0.94 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 9 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 9 1.5</size></box></geometry>
          <material><ambient>0.86 0.86 0.88 1</ambient><diffuse>0.92 0.92 0.94 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 9 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 9 1.5</size></box></geometry>
          <material><ambient>0.86 0.86 0.88 1</ambient><diffuse>0.92 0.92 0.94 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== interior partitions ==================== -->

    <model name="partition_a">
      <static>true</static>
      <pose>-2.0 1.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 4.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 4.0 1.5</size></box></geometry>
          <material><ambient>0.78 0.79 0.82 1</ambient><diffuse>0.85 0.86 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="partition_b">
      <static>true</static>
      <pose>2.5 -1.2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 0.12 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.12 1.5</size></box></geometry>
          <material><ambient>0.78 0.79 0.82 1</ambient><diffuse>0.85 0.86 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="partition_c">
      <static>true</static>
      <pose>0.5 3.2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.4 0.12 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.4 0.12 1.5</size></box></geometry>
          <material><ambient>0.78 0.79 0.82 1</ambient><diffuse>0.85 0.86 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== clutter: boxes and pillars ==================== -->

    <model name="crate_1">
      <static>true</static>
      <pose>1.4 2.0 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.55 0.36 0.20 1</ambient><diffuse>0.66 0.44 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crate_2">
      <static>true</static>
      <pose>3.6 1.6 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><ambient>0.55 0.36 0.20 1</ambient><diffuse>0.66 0.44 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_1">
      <static>true</static>
      <pose>-4.2 -2.4 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
          <material><ambient>0.72 0.72 0.75 1</ambient><diffuse>0.82 0.82 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>-1.0 -3.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
          <material><ambient>0.72 0.72 0.75 1</ambient><diffuse>0.82 0.82 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>4.6 -3.4 0.38 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.7 0.76</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.7 0.76</size></box></geometry>
          <material><ambient>0.42 0.42 0.45 1</ambient><diffuse>0.52 0.52 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>