Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /LaserScan1
        - /Path1
      Splitter Ratio: 0.5
    Tree Height: 620
  - Class: rviz_common/Views
    Name: Views
    Expanded:
      - /Current View1
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Color: 110; 112; 120
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Alpha: 0.85
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Topic:
        Value: /scan
      Color Transformer: FlatColor
      Color: 255; 110; 20
      Size (m): 0.03
      Style: Flat Squares
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: GlobalPlan
      Topic:
        Value: /plan
      Color: 30; 200; 255
      Line Style:
        Line Width: 0.05
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: LocalPlan
      Topic:
        Value: /local_plan
      Color: 120; 255; 140
      Line Style:
        Line Width: 0.03
    - Class: rviz_default_plugins/Polygon
      Enabled: true
      Name: Footprint
      Topic:
        Value: /local_costmap/published_footprint
      Color: 255; 255; 90
      Alpha: 0.6
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: GlobalCostmap
      Topic:
        Value: /global_costmap/costmap
      Alpha: 0.4
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: LocalCostmap
      Topic:
        Value: /local_costmap/costmap
      Alpha: 0.5
      Color Scheme: costmap
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 0.5
  Enabled: true
  Global Options:
    Background Color: 26; 28; 32
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 45
      Angle: 0
      Name: Current View
      Target Frame: map
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600