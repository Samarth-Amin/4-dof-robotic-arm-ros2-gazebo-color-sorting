<?xml version="1.0"?>
<robot name="scout" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       SCOUT - differential drive indoor mobile robot
       Frame tree:
         map -> odom -> base_footprint -> base_link -> {wheels, sensors}

       All three ground contacts (2 drive wheels + 2 caster balls)
       touch z = 0 when base_footprint sits on the ground plane,
       so the robot spawns level and does not pitch.
       ============================================================ -->

  <xacro:property name="base_length"   value="0.44"/>
  <xacro:property name="base_width"    value="0.36"/>
  <xacro:property name="base_height"   value="0.14"/>
  <xacro:property name="base_z"        value="0.12"/>
  <xacro:property name="base_mass"     value="3.0"/>

  <xacro:property name="wheel_radius"  value="0.085"/>
  <xacro:property name="wheel_width"   value="0.045"/>
  <xacro:property name="wheel_y"       value="0.19"/>
  <xacro:property name="wheel_mass"    value="0.30"/>

  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_x"      value="0.16"/>
  <xacro:property name="caster_mass"   value="0.10"/>

  <material name="scout_dark">
    <color rgba="0.12 0.13 0.15 1.0"/>
  </material>
  <material name="scout_accent">
    <color rgba="0.95 0.45 0.10 1.0"/>
  </material>
  <material name="scout_grey">
    <color rgba="0.55 0.57 0.60 1.0"/>
  </material>

  <!-- ==================== base ==================== -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="scout_dark"/>
    </visual>
    <!-- orange accent band so the robot reads clearly on camera -->
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length + 0.004} ${base_width + 0.004} 0.035"/>
      </geometry>
      <material name="scout_accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="0.0373" ixy="0" ixz="0"
               iyy="0.0533" iyz="0"
               izz="0.0808"/>
    </inertial>
  </link>

  <!-- ==================== drive wheels ==================== -->

  <xacro:macro name="drive_wheel" params="side mirror">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="scout_grey"/>
      </visual>
      <!-- hub marker: makes wheel rotation visible in Gazebo -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.45}" length="${wheel_width + 0.002}"/>
        </geometry>
        <material name="scout_accent"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.000593" ixy="0" ixz="0"
                 iyy="0.000593" iyz="0"
                 izz="0.001084"/>
      </inertial>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${mirror * wheel_y} ${wheel_radius - base_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>

    <!-- high lateral-axial grip for the drive wheels -->
    <gazebo reference="${side}_wheel_link">
      <mu1>1.2</mu1>
      <mu2>0.2</mu2>
      <material>
        <ambient>0.30 0.31 0.33 1</ambient>
        <diffuse>0.38 0.39 0.42 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
      </material>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel side="left"  mirror="1"/>
  <xacro:drive_wheel side="right" mirror="-1"/>

  <!-- ==================== casters ==================== -->

  <xacro:macro name="caster" params="name x_sign">
    <link name="${name}_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="scout_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${caster_mass}"/>
        <inertia ixx="0.000036" ixy="0" ixz="0"
                 iyy="0.000036" iyz="0"
                 izz="0.000036"/>
      </inertial>
    </link>

    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x_sign * caster_x} 0 ${caster_radius - base_z}" rpy="0 0 0"/>
    </joint>

    <!-- near-zero friction: a fixed sphere must slide, not drag -->
    <gazebo reference="${name}_caster_link">
      <mu1>0.001</mu1>
      <mu2>0.001</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" x_sign="1"/>
  <xacro:caster name="rear"  x_sign="-1"/>

  <!-- ==================== lidar ==================== -->

  <link name="lidar_mast_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.06"/>
      </geometry>
      <material name="scout_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000015" ixy="0" ixz="0"
               iyy="0.000015" iyz="0"
               izz="0.000008"/>
    </inertial>
  </link>

  <joint name="lidar_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mast_link"/>
    <origin xyz="0 0 ${base_height/2 - 0.03}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.055"/>
      </geometry>
      <material name="scout_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.029" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.006"/>
      </geometry>
      <material name="scout_accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.000161" ixy="0" ixz="0"
               iyy="0.000161" iyz="0"
               izz="0.000203"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mast_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.0625" rpy="0 0 0"/>
  </joint>

  <!-- sensor MUST live under <gazebo reference=...> for URDF -> SDF -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ==================== depth camera ==================== -->

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.09 0.03"/>
      </geometry>
      <material name="scout_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.09 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.000005" ixy="0" ixz="0"
               iyy="0.000005" iyz="0"
               izz="0.000004"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${base_length/2 + 0.012} 0 0.055" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="rgbd_camera">
      <topic>camera</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- ==================== Gazebo plugins ==================== -->

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2 * wheel_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>1.6</max_angular_velocity>
      <min_angular_velocity>-1.6</min_angular_velocity>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>
      <ambient>0.12 0.13 0.15 1</ambient>
      <diffuse>0.17 0.18 0.21 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
    </material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>

</robot>