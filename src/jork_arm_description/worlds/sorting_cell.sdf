        <parent>conveyor_frame</parent>
        <child>puck_1_x_stage</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-0.50</lower><upper>0.50</upper><effort>800.0</effort><velocity>1.0</velocity></limit>
          <dynamics><damping>5.0</damping><friction>0.0</friction></dynamics>
        </axis>
      </joint>

