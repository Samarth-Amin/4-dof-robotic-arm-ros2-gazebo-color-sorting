<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="sorting_cell_world">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.90 0.90 0.90 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material><ambient>0.78 0.78 0.80 1</ambient><diffuse>0.78 0.78 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="overhead_vision_sensor">
      <static>true</static>
      <pose>0.2166 -0.0000 0.72 0 1.5707963 0</pose>
      <link name="camera_link">
        <sensor name="overhead_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <topic>/camera/image_raw</topic>
          <camera>
            <horizontal_fov>0.70</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>3.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- SMOOTH STADIUM LOOP CONVEYOR (ROUNDED INNER ISLAND ENDS, NO RAIL COLLISIONS TO SNAG BLOCKS) -->
    <model name="conveyor_belt">
      <pose>0.2166 -0.0000 0.0 0 0 0</pose>
      <link name="conveyor_frame">
        <inertial>
          <mass>150.0</mass>
          <inertia><ixx>10.0</ixx><ixy>0</ixy><ixz>0</ixz><iyy>10.0</iyy><iyz>0</iyz><izz>10.0</izz></inertia>
        </inertial>
        <!-- Active Pickup Lane Deck -->
        <visual name="active_bed_vis">
          <pose>0 -0.05 0.0315 0 0 0</pose>
          <geometry><box><size>0.12 1.00 0.063</size></box></geometry>
          <material><ambient>0.20 0.21 0.24 1</ambient><diffuse>0.20 0.21 0.24 1</diffuse></material>
        </visual>

        <!-- Parallel Return Loop Lane Deck (X = +0.28m) -->
        <visual name="return_lane_vis">
          <pose>0.28 -0.05 0.0315 0 0 0</pose>
          <geometry><box><size>0.12 1.00 0.063</size></box></geometry>
          <material><ambient>0.20 0.21 0.24 1</ambient><diffuse>0.20 0.21 0.24 1</diffuse></material>
        </visual>

        <!-- Front Turnaround 180-deg Drum (Y = +0.45m, Radius = 0.20m) -->
        <visual name="loop_end_front">
          <pose>0.14 0.45 0.0315 0 0 0</pose>
          <geometry><cylinder><radius>0.20</radius><length>0.063</length></cylinder></geometry>
          <material><ambient>0.24 0.25 0.28 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse></material>
        </visual>
        <visual name="loop_end_front_hub">
          <pose>0.14 0.45 0.034 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.066</length></cylinder></geometry>
          <material><ambient>0.15 0.16 0.18 1</ambient><diffuse>0.15 0.16 0.18 1</diffuse></material>
        </visual>

        <!-- Rear Turnaround 180-deg Drum (Y = -0.55m, Radius = 0.20m) -->
        <visual name="loop_end_rear">
          <pose>0.14 -0.55 0.0315 0 0 0</pose>
          <geometry><cylinder><radius>0.20</radius><length>0.063</length></cylinder></geometry>
          <material><ambient>0.24 0.25 0.28 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse></material>
        </visual>
        <visual name="loop_end_rear_hub">
          <pose>0.14 -0.55 0.034 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.066</length></cylinder></geometry>
          <material><ambient>0.15 0.16 0.18 1</ambient><diffuse>0.15 0.16 0.18 1</diffuse></material>
        </visual>

        <!-- Rounded Center Island Divider (Flush with Drums, Zero Sharp Corners!) -->
        <visual name="rail_inner_island">
          <pose>0.14 -0.05 0.034 0 0 0</pose>
          <geometry><box><size>0.16 1.00 0.066</size></box></geometry>
          <material><ambient>0.15 0.16 0.18 1</ambient><diffuse>0.15 0.16 0.18 1</diffuse></material>
        </visual>

        <!-- Spawn Feeder Arch on Return Lane (X = +0.28m, Y = -0.25m) -->
        <visual name="spawn_hood_top">
          <pose>0.28 -0.25 0.165 0 0 0</pose>
          <geometry><box><size>0.15 0.14 0.022</size></box></geometry>
          <material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.28 0.32 0.38 1</diffuse></material>
        </visual>
        <visual name="spawn_hood_left">
          <pose>0.212 -0.25 0.105 0 0 0</pose>
          <geometry><box><size>0.014 0.14 0.12</size></box></geometry>
          <material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.28 0.32 0.38 1</diffuse></material>
        </visual>
        <visual name="spawn_hood_right">
          <pose>0.348 -0.25 0.105 0 0 0</pose>
          <geometry><box><size>0.014 0.14 0.12</size></box></geometry>
          <material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.28 0.32 0.38 1</diffuse></material>
        </visual>

        <!-- Smooth Catch Deck below pucks -->
        <collision name="deck_catch_col">
          <pose>0.14 -0.05 0.030 0 0 0</pose>
          <geometry><box><size>0.42 1.44 0.060</size></box></geometry>
        </collision>
      </link>

      <joint name="conveyor_world_fixed" type="fixed">
        <parent>world</parent>
        <child>conveyor_frame</child>
      </joint>

      
      <link name="puck_1_x_stage">
        <pose>0.0000 -0.1400 0.065 0 0 0</pose>
        <inertial><mass>0.50</mass><inertia><ixx>0.002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.002</iyy><iyz>0</iyz><izz>0.002</izz></inertia></inertial>
